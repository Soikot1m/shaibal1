# ---- Database (required) ----
# Local PostgreSQL example below. For hosting, paste the connection string from
# Neon / Supabase / your VPS here (Neon URLs end with ?sslmode=require).
# See DEPLOYMENT.md, step 4–5.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Site ----
# Public URL of the deployed site (used for QR codes, sitemap, share links, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Extra hosts allowed to call Server Actions when running behind a proxy/CDN (comma-separated, optional)
ALLOWED_ORIGINS=

# ---- Docker Compose only (docker-compose.yml) ----
POSTGRES_PASSWORD=change-this-password
# SEED_DEMO=true   ← only for the very first start; wipes and re-creates demo data

# ---- Supabase (optional: auth/storage/realtime when migrating from local Postgres) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Maps (OpenStreetMap embeds are used by default) ----
NEXT_PUBLIC_MAP_PROVIDER=osm
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# ---- Payments (server-side only; never expose in client code) ----
PAYMENT_WEBHOOK_SECRET=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# ---- AI assistant (OpenAI-compatible; rule-based fallback works without it) ----
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# ---- Messaging providers (optional) ----
EMAIL_API_KEY=
SMS_API_KEY=
WHATSAPP_API_KEY=

# ---- Analytics (loaded only after cookie consent) ----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
